<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;MYTEST</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <!-- IHttpService 所需的 IHttpClientFactory / ILogger 抽象 -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <!-- GBK/Big5 等 CodePages 编码由 net10.0 共享框架内置（CodePagesEncodingProvider），无需单独引用包；
         Mapperly / Serilog 全仓库零代码引用，已移除。 -->
  </ItemGroup>

</Project>
